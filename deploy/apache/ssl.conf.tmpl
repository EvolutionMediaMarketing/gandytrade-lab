# GandyTrade Lab: applies to __DOMAIN__ only (HTTPS).
# Installed by deploy/scripts/04-apache.sh. Remove with: 04-apache.sh --remove

# www.__DOMAIN__ -> __DOMAIN__ (certificate checks left alone)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^/(.*)$ https://__DOMAIN__/$1 [R=301,L]

# Pass the site to the app, which only listens on the server itself.
# /.well-known stays with cPanel so AutoSSL can keep renewing the certificate.
ProxyRequests Off
ProxyPreserveHost On
ProxyPass /.well-known !

# cPanel's error pages (e.g. /401.shtml) must not be sent to the app, or a refused
# password shows the app's page instead of the browser's password prompt.
ErrorDocument 400 default
ErrorDocument 401 default
ErrorDocument 403 default
ErrorDocument 404 default
ErrorDocument 500 default
ErrorDocument 502 default
ErrorDocument 503 default

ProxyPass / http://127.0.0.1:__PORT__/ timeout=60
ProxyPassReverse / http://127.0.0.1:__PORT__/
RequestHeader set X-Forwarded-Proto "https"

# Proves to the app that a request came through this gate. The secret lives in a
# root-only file (other accounts on the server can't read it), so a program that
# connects to the app's port directly is refused. "set" replaces any value a
# visitor tries to send themselves.
Include __PROXY_SECRET_CONF__

# Browsers remember to use HTTPS only for this site for a year.
Header always set Strict-Transport-Security "max-age=31536000"

# Keep the site out of search engines.
Header always set X-Robots-Tag "noindex, nofollow, noarchive"

# Password gate in front of everything except certificate checks.
<Location "/">
    AuthType Basic
    AuthName "GandyTrade Lab (private)"
    AuthUserFile __HTPASSWD__
    Require valid-user
</Location>
<Location "/.well-known">
    Require all granted
</Location>
