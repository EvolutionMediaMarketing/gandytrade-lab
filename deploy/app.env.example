# Created automatically on the server at ~/gandytrade/app.env by 03-install-app.sh.
# This example shows the settings; never commit the real file.

GT_DATABASE_URL=postgresql://gandytrade:<generated>@gandytrade-db:5432/gandytrade
GT_SECRET_KEY=<generated>
GT_COOKIE_SECURE=true

# Read-only market data. Leave blank to use clearly labelled sample data.
# OANDA: a token from a DEMO ("fxTrade Practice") account only.
GT_OANDA_TOKEN=
# Twelve Data: the free Basic plan key.
GT_TWELVEDATA_KEY=
