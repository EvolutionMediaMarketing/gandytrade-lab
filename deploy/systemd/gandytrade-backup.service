# GandyTrade Lab nightly backup (see deploy/scripts/backup.sh). Started by gandytrade-backup.timer.
[Unit]
Description=GandyTrade Lab nightly backup
After=gandytrade-db.service

[Service]
Type=oneshot
ExecStart=/bin/bash __REPO__/deploy/scripts/backup.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=900
