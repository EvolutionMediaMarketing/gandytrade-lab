# Runs the backup every night at about 02:30 UTC (03:30 UK in summer). If the server was off
# at that time, it runs soon after it starts again.
[Unit]
Description=GandyTrade Lab nightly backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
